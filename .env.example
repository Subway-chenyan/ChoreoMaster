# CosStage local development
APP_HOST=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_AI_BACKEND_URL=http://127.0.0.1:8000
VITE_MEMBER_TOKEN=

# 管理员发放的 Agent 访问 Key，多个 Key 使用英文逗号分隔。
AGENT_ACCESS_KEYS=
# 生产环境建议设为 false，禁用内置本地开发 Key。
ALLOW_DEV_MEMBER_TOKEN=false

# Text-only formation Agent:
# - deepseek: call DeepSeek directly
# - gateway: call CHOREO_AGENT_MODEL_URL
# - rule: deterministic local fallback, no API key required
LLM_PROVIDER=rule
CHOREO_AGENT_MODEL_TIMEOUT=90

# DeepSeek settings, used when LLM_PROVIDER=deepseek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Custom OpenAI-compatible/business gateway, used when LLM_PROVIDER=gateway
CHOREO_AGENT_MODEL_URL=
CHOREO_AGENT_MODEL_TOKEN=

# Music + sketch multimodal Agent.
# Audio/image understanding currently requires Gemini.
MULTIMODAL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Optional: override the Python executable used by the launcher.
PYTHON=

# Release dry-run only. Production values live in GitHub Environment secrets/variables.
COSSTAGE_REQUIRE_CODE_SIGNING=false
COSSTAGE_WINDOWS_PUBLISHER_NAME=
