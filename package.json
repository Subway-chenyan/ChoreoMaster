{
  "name": "cosstage-desktop",
  "description": "CosStage desktop choreography editor",
  "author": "CosStage",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-dev.cjs",
    "start:setup": "node scripts/start-dev.cjs --install",
    "dev:backend": "node scripts/run-backend-dev.cjs",
    "dev:electron": "concurrently \"vite\" \"tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build:main && npm run build && electron-builder --config electron-builder.config.cjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "test:backend": "node scripts/run-backend-pytest.cjs",
    "test:project": "npm run build:main && node --test tests/project-service.test.mjs",
    "test:desktop": "node --experimental-strip-types --test tests/desktop-regressions.test.mjs tests/stage-grid-behavior.test.ts",
    "test": "npm run test:backend && npm run test:project && npm run test:desktop && npm run build"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "core-util-is": "^1.0.3",
    "electron-is-dev": "^3.0.1",
    "mp4-muxer": "^5.2.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@google/genai": "^1.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.182.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "lucide-react": "^0.554.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  }
}
